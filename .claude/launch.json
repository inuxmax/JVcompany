{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "vanphong-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 2501,
      "url": "http://127.0.0.1:2501"
    },
    {
      "name": "docs-site",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4173",
        "--bind",
        "127.0.0.1",
        "--directory",
        "docs"
      ],
      "port": 4173,
      "url": "http://127.0.0.1:4173"
    }
  ]
}
