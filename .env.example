# Kết nối MongoDB (mặc định MongoDB cài trên máy)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=jvcompany

# Cho phép truy cập từ máy khác trong mạng LAN (mặc định chỉ máy này).
# Đặt khóa truy cập rồi mở http://<ip>:2501/?key=<khóa> một lần để lưu cookie.
# JVCOMPANY_ACCESS_KEY=

# Tắt worker agent (ví dụ khi chạy nhiều instance)
# JVCOMPANY_WORKER=off
